{
    "name": "bii/api",
    "description": "Bengali Islamic Institute — Yii2 JSON API (replaces FastAPI backend)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.54",
        "firebase/php-jwt": "^6",
        "guzzlehttp/guzzle": "^7",
        "dompdf/dompdf": "^3.1",
        "jarir-ahmed/kill-switch": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "platform": {
            "php": "8.1.99"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "audit": {
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": {
                    "reason": "Algorithm strictly pinned to HS256 in code; advisory is about alg-confusion, not applicable."
                }
            }
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
