# Merged public_html root: React SPA + Yii2 API on the same docroot.
Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass through the Authorization header so Yii2 JWT auth can read the Bearer token.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 0) Explicit opt-in: serve anything under /runtime/ as-is (do NOT route
    #    through Yii2 or the SPA fallback).
    RewriteRule ^runtime/ - [L,NC]

    # 1) Serve real files/dirs directly (React static assets, uploaded files, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2) /api/* → Yii2 front controller
    RewriteRule ^api(/?)(.*)$ index.php [L,QSA]

    # 3) SPA fallback: any other path → React app
    RewriteRule ^ index.html [L]
</IfModule>

# Basic security
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── Cache static assets for 1 year (content-hashed filenames) ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
