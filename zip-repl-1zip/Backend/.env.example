# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_NAME=bii
DB_USER=root
DB_PASS=

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── App ──────────────────────────────────────────────────────
SITE_URL=https://your-domain.com
CORS_ORIGINS=https://your-frontend-domain.com
APP_VERSION=1.0.0
INSTITUTE_NAME_BN=বাঙালি ইসলামিক ইনস্টিটিউট
INSTITUTE_NAME_EN=Bengali Islamic Institute

# ── SMTP (OTP / password-reset emails) ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_PORT=465

# ── Yii runtime ──────────────────────────────────────────────
YII_ENV=prod
YII_DEBUG=0

# ── One-time data migration (tools/migrate_mongo_to_mysql.py) ─
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGODB_DB=bii
