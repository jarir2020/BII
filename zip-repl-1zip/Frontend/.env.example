# ──────────────────────────────────────────────────────────────
# Frontend environment variables
# ──────────────────────────────────────────────────────────────
# In development, the CRACO dev server proxies /api → http://localhost:8000
# so REACT_APP_BACKEND_URL is NOT required locally.
#
# In production builds, set this to your deployed backend URL:
# REACT_APP_BACKEND_URL=https://your-backend.example.com
